# ==========================================
# Настройки автоотклика на hh.ru
# ==========================================

# 1. Поисковый запрос с вашими фильтрами на hh.ru
# Зайдите на hh.ru, выберите город/удаленку, зарплату, опыт, нажмите Найти и скопируйте ссылку сюда:
HH_SEARCH_URL=https://hh.ru/search/vacancy?text=дизайнер&area=113&schedule=remote

# 2. Ключ Google Gemini API для генерации писем (бесплатно: https://aistudio.google.com/)
# Если оставить пустым или если из РФ нет VPN/прокси, бот автоматически использует умный встроенный ATS-генератор.
GEMINI_API_KEY=
# GEMINI_PROXY=http://127.0.0.1:10809
# GEMINI_MODEL=gemini-2.5-flash

# 3. Ваша должность и краткий опыт
MY_ROLE="Веб-дизайнер / Frontend-разработчик (UI/UX, Design Technologist)"
PORTFOLIO_URL="https://228burger228.github.io/burgerportfolio2.0/#design"
GAME_PORTFOLIO_URL="https://228burger228.github.io/Game-portfolio/"
TELEGRAM="@aimovl"

# 4. Автозаполнение анкет и вопросов работодателя
ANSWER_FULL_NAME="Дмитрий"
ANSWER_PHONE=""
ANSWER_EMAIL=""
ANSWER_CITIZENSHIP="РФ"
ANSWER_EXPERIENCE_YEARS=3
ANSWER_SALARY=80000
ANSWER_CITY="Москва"

# 5. Лимиты и безопасность
# Максимум откликов в день (рекомендуется 50-80)
MAX_APPLIES_PER_DAY=60

# Случайные задержки между действиями (в секундах)
MIN_DELAY_SECONDS=4
MAX_DELAY_SECONDS=10

# 6. Режим работы браузера и оптимизация
HEADLESS=false
DISK_CACHE_LIMIT_MB=10
ENABLE_USER_ACTIVITY_PAUSE=false

# 7. Черные списки (через запятую)
BLACKLIST_WORDS=senior,lead,тимлид,руководитель,стажер,стажёр,преподаватель,1c,1с,qa,тестировщик
BLACKLIST_COMPANIES=
